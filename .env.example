# 이 파일은 「어떤 값이 필요한가」만 알려 준다.
# 🔴 실제 Secret 을 여기에 적지 않는다. 복사해서 .env 를 만들고 거기에 채운다 (.env 는 Git 제외).
#
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Database (필수)
# ---------------------------------------------------------------------------
# docker-compose.yml 로 띄운 경우의 기본값과 같은 형태다. 비밀번호는 각자 정한다.
DATABASE_URL=postgresql://code_intelligence:PASSWORD@localhost:5432/code_intelligence

# docker-compose.yml 이 읽는 값. DATABASE_URL 과 반드시 짝을 맞춘다.
POSTGRES_USER=code_intelligence
POSTGRES_PASSWORD=
POSTGRES_DB=code_intelligence
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# 인증 (필수)
#
# 🔴 셋 다 없으면 로그인 경로가 «조용히 꺼지는 대신» 실패한다(src/lib/env.schema.ts).
#    조용히 꺼지면 배포 시점에 알아챌 수 없다.
# 🔴 전부 Server-only 다. NEXT_PUBLIC_ 로 내보내지 않는다.
# ---------------------------------------------------------------------------

# 세션 쿠키 서명·암호화 키. 32자 이상.
#
#   openssl rand -base64 32
#   npx auth secret
AUTH_SECRET=

# GitHub OAuth App 의 값. 만드는 방법과 Callback URL 은 README 를 본다.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# GitHub Code Evidence 확인 (선택)
#
# 🔴 둘 다 없어도 ReviewTrace 는 그대로 돈다. Evidence 가 UNVERIFIED·UNAVAILABLE 로
#    남을 뿐이다 — 확인 수단이 없다고 기록 자체를 거절하지 않는다.
# 🔴 이 선택 Token은 공개 저장소 fallback용이다. Private 저장소는 아래 GitHub App
#    installation이 같은 Workspace에 연결되고 해당 numeric repository id를 허용할 때만 읽는다.
# 🔴 로그인에 쓰는 GitHub OAuth Token 과 다른 값이다. 여기 로그인 Token 을 넣지 마라.
# ---------------------------------------------------------------------------

# 익명 호출의 시간당 한도(60회)를 올리기 위한 Server-only Token.
# 없으면 익명으로 호출한다. Private Repository 권한을 이 값에 주지 않는다.
GITHUB_API_TOKEN=

# GitHub Enterprise 를 쓰는 경우에만 바꾼다. 비우면 https://api.github.com 이다.
# 원격 endpoint는 HTTPS만 허용한다. 로컬 시험용 loopback HTTP는 허용한다.
GITHUB_API_URL=

# ---------------------------------------------------------------------------
# GitHub App Repository integration (private repository 포함)
# OAuth login app과 별개이며 전부 Server-only 다.
# Private Key PEM 원문은 source control에 넣지 않는다.
# ---------------------------------------------------------------------------
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_SLUG=
GITHUB_WEB_URL=https://github.com
